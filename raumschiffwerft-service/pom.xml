<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.kore.raumschiffwerft</groupId>
    <artifactId>raumschiffwerft-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>raumschiffwerft-service</artifactId>

  <properties>
    <!-- Quarkiverse-OpenFeature-Extension (flagd, Datei-Modus) -->
    <quarkus-openfeature.version>1.0.0.Beta1</quarkus-openfeature.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.kore.raumschiffwerft</groupId>
      <artifactId>raumschiffwerft-adapter-imperium</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.kore.raumschiffwerft</groupId>
      <artifactId>raumschiffwerft-adapter-rebellion</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <!-- Eigene REST-Schnittstelle (Auftraege anlegen und anzeigen) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <!-- Routing und Transformation ins kanonische Modell und an die Ziele -->
    <dependency>
      <groupId>org.apache.camel.quarkus</groupId>
      <artifactId>camel-quarkus-core</artifactId>
    </dependency>
    <!-- direct:-Endpunkte der Zustell-Route -->
    <dependency>
      <groupId>org.apache.camel.quarkus</groupId>
      <artifactId>camel-quarkus-direct</artifactId>
    </dependency>
    <!-- Timer-Route des Abgleichs faelliger Zustellungen -->
    <dependency>
      <groupId>org.apache.camel.quarkus</groupId>
      <artifactId>camel-quarkus-timer</artifactId>
    </dependency>
    <!-- Outbox-Relay (Producer) und Journal-Indexierung (Consumer) -->
    <dependency>
      <groupId>org.apache.camel.quarkus</groupId>
      <artifactId>camel-quarkus-kafka</artifactId>
    </dependency>
    <!-- OpenSearch-Indexierung (REST-Client) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-jackson</artifactId>
    </dependency>
    <!-- Persistenz: Flyway-Migrationen und plain JDBC gegen die devenv-Postgres -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>
    <!-- Bean Validation der Annahme (Idempotency-Key- und Body-Regeln) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-validator</artifactId>
    </dependency>
    <!-- OpenTelemetry: Traces ueber OTLP zum Collector -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-opentelemetry</artifactId>
    </dependency>
    <!-- Metriken ueber Micrometer mit OTLP-Registry -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-micrometer</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-otlp</artifactId>
    </dependency>
    <!-- Zielsystemwahl per OpenFeature-Flag (flagd, Datei-Modus flags/flags.json) -->
    <dependency>
      <groupId>io.quarkiverse.openfeature</groupId>
      <artifactId>quarkus-openfeature-flagd</artifactId>
      <version>${quarkus-openfeature.version}</version>
    </dependency>
    <!-- REST-Aufrufe in Integrationstests -->
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Asynchrones Warten auf konvergierende Zustaende in Integrationstests -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Integrationstests (*IT, Failsafe) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Architekturtests -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Integrationstests laufen via Failsafe -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Native-Kompilierung via GraalVM: mvn -Pnative package -->
    <profile>
      <id>native</id>
      <properties>
        <quarkus.native.enabled>true</quarkus.native.enabled>
      </properties>
    </profile>
  </profiles>
</project>
