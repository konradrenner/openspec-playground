<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.kore.raumschiffwerft</groupId>
    <artifactId>raumschiffwerft-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>raumschiffwerft-adapter-imperium</artifactId>

  <properties>
    <!-- Gleiche Version wie der von quarkus-cxf verwaltete Apache CXF (4.1.7) -->
    <cxf.codegen.version>4.1.7</cxf.codegen.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.kore.raumschiffwerft</groupId>
      <artifactId>raumschiffwerft-model</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <!-- SOAP-Aufruf des Imperiums via Jakarta-EE-APIs (Jakarta XML Web Services) -->
    <dependency>
      <groupId>io.quarkiverse.cxf</groupId>
      <artifactId>quarkus-cxf</artifactId>
    </dependency>
    <!-- Client-Span je externem Aufruf (Adapter-Spans am Boundary) -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
    </dependency>
    <!-- QuarkusTest-basierte Integrationstests (*IT, Failsafe) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Client-Stubs aus der WSDL generieren (SOAP 1.1, document/literal) -->
      <plugin>
        <groupId>org.apache.cxf</groupId>
        <artifactId>cxf-codegen-plugin</artifactId>
        <version>${cxf.codegen.version}</version>
        <executions>
          <execution>
            <id>generate-imperium-wsdl-stubs</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>wsdl2java</goal>
            </goals>
            <configuration>
              <wsdlOptions>
                <wsdlOption>
                  <wsdl>${project.basedir}/src/main/resources/wsdl/imperium-werft.wsdl</wsdl>
                  <extraargs>
                    <extraarg>-p</extraarg>
                    <extraarg>org.kore.raumschiffwerft.adapter.imperium.werft.v1</extraarg>
                  </extraargs>
                </wsdlOption>
              </wsdlOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Jandex-Index, damit Quarkus die Adapter-Klassen findet -->
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
      </plugin>
      <!-- App-Modell fuer Tests schreiben; KEIN build-Ziel -> Bibliothek bleibt Bibliothek -->
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>lib-test-bootstrap</id>
            <goals>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
