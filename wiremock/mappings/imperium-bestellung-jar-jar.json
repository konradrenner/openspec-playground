{
  "name": "imperium_bestellung_jar_jar",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/imperium",
    "bodyPatterns": [
      {
        "matchesXPath": "//*[local-name()='besteller'][contains(text(), 'Jar Jar')]"
      }
    ]
  },
  "response": {
    "status": 500,
    "headers": {
      "Content-Type": "text/xml; charset=utf-8"
    },
    "body": "<soapenv:Envelope xmlns:soapenv='http://schemas.xmlsoap.org/soap/envelope/'><soapenv:Body><soapenv:Fault><faultcode>soapenv:Server</faultcode><faultstring>Besteller nicht bonitaetsgeprueft</faultstring></soapenv:Fault></soapenv:Body></soapenv:Envelope>"
  }
}
